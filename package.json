{
  "name": "bettercomms",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:desktop-wails": "npm --prefix apps/desktop-wails run dev",
    "build:desktop-wails": "npm --prefix apps/desktop-wails run build",
    "build:desktop-wails:macos": "bash scripts/package-desktop-wails-macos.sh",
    "build": "npm run build -w apps/web",
    "test:e2e": "playwright test",
    "test": "npm run test -w apps/web"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.2",
    "prettier": "^3.9.6"
  }
}
