# Matches compose.yaml: the postgres service publishes 5432 on 54329 and its
# password is local-development-only.
DATABASE_URL=postgres://bettercomms:local-development-only@127.0.0.1:54329/bettercomms?sslmode=disable
HTTP_ADDR=:8080
APP_URL=http://localhost:5173
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Must be byte-identical to a redirect URI registered in the WorkOS dashboard.
# The server defaults to the APP_URL one when this is unset, which is what a
# development run uses; the desktop sign-in hand-off returns through it too.
WORKOS_REDIRECT_URI=http://localhost:5173/api/v1/auth/callback
DEV_AUTH=true
COOKIE_SECURE=false
ICE_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SECRET=replace-with-the-coturn-static-auth-secret
WEB_DIST=
MIGRATIONS_DIR=migrations
