# Matches compose.yaml: the postgres service publishes 5432 on 54329 and its
# password is local-development-only.
DATABASE_URL=postgres://bettercomms:local-development-only@127.0.0.1:54329/bettercomms?sslmode=disable
HTTP_ADDR=:8080
APP_URL=http://localhost:5173
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Must be byte-identical to a redirect URI registered in the WorkOS dashboard.
# The server defaults to the APP_URL one when this is unset, which is what a
# development run uses; the desktop sign-in hand-off returns through it too.
WORKOS_REDIRECT_URI=http://localhost:5173/api/v1/auth/callback
DEV_AUTH=true
COOKIE_SECURE=false
ICE_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SECRET=replace-with-the-coturn-static-auth-secret
WEB_DIST=
MIGRATIONS_DIR=migrations
# Optional S3 attachments. Configure an existing private bucket and grant
# s3:PutObject, s3:GetObject, and s3:DeleteObject on messages/*.
# Credentials remain on the server; IAM roles or AWS_PROFILE also work.
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Ordinary files default to 500 MiB each (four per message). Configurable from
# 1 MiB to 2 GiB; voice notes remain independently capped at 10 MiB/two minutes.
# Uploads spool to private temporary disk files, so reserve space on the API host.
ATTACHMENT_MAX_BYTES=524288000
# Optional browser Web Push. Generate a pair with `go run ./cmd/vapid`
# inside server/. Keep the private key on the server, never in VITE_ variables.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
