.env
.env.*
!.env.example
node_modules/
dist/
target/
*.log
test-results/
playwright-report/
tests/screenshots/
*.tsbuildinfo
.local/
server/bettercomms.exe

# The Wails host embeds a staged copy of apps/web/dist. Keep the directory so
# `//go:embed all:frontend/dist` still compiles on a clean checkout, but do not
# commit the build output into it.
!apps/desktop-wails/frontend/dist/
apps/desktop-wails/frontend/dist/*
!apps/desktop-wails/frontend/dist/.gitkeep
apps/desktop-wails/bin/
apps/desktop-wails/build/ios/

apps/sfu/turnserver.conf

# Android build output and machine-local SDK paths
apps/desktop-wails/android/.gradle/
apps/desktop-wails/android/generated/
apps/desktop-wails/android/app/build/
apps/desktop-wails/android/build/
apps/desktop-wails/android/local.properties
*.keystore
*.jks
