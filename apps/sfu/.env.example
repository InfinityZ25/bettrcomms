# Address the HTTP/WebSocket signaling server binds to inside the
# container. TLS terminates in front of this process (see
# docs/SFU_DEPLOYMENT.md) — nginx/caddy on the host proxies 443 -> this.
HTTP_ADDR=0.0.0.0:8443

# Address the single shared UDP media socket binds to. One socket handles
# every session (ICE-lite + ufrag-based demuxing) — this does not need to
# scale with participant count, so there is deliberately one port, not a
# range.
UDP_ADDR=0.0.0.0:3478

# The box's PUBLIC ip:port for media, exactly as reachable from the
# internet — this gets embedded as the ICE-lite candidate in every SDP
# answer. Must match the port Linode's firewall opens for UDP media and
# the same port UDP_ADDR binds to. NOT a private/NAT address.
PUBLIC_MEDIA_ADDR=203.0.113.10:3478

# Shared secret used to verify join tokens minted by the Railway API's
# `POST /api/v1/sfu/join`. Must be identical here and in the Railway
# `bettrcomms` service's SFU_JOIN_SECRET. Generate with:
#   openssl rand -base64 48
# Never commit the real value; this file only holds placeholders.
SFU_JOIN_SECRET=replace-with-a-real-random-secret-at-least-32-bytes-long

# Numeric id for this SFU process. A single-box deployment only needs one
# value; only relevant once this grows to multiple SFUs behind Railway's
# SFU-discovery logic.
SFU_ID=1

# Shared secret for coturn's ephemeral TURN credentials (its
# `static-auth-secret`). Must be identical here and in the Railway
# `bettrcomms` service's TURN_SECRET — deploy.sh renders
# turnserver.conf.template with this value; never edit turnserver.conf by
# hand, it's generated and gitignored. Generate with:
#   openssl rand -base64 48
TURN_SECRET=replace-with-a-real-random-secret

# Log verbosity (tracing-subscriber EnvFilter syntax), e.g. "info",
# "debug", "bettrcomms_sfu=debug,warn".
RUST_LOG=info
