{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [{
      "label": "main",
      "title": "BetterComms",
      "url": "https://app.bettrcomms.com",
      "width": 1440,
      "height": 900,
      "minWidth": 960,
      "minHeight": 640,
      "resizable": true,
      "decorations": false,
      "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
    }]
  }
}
