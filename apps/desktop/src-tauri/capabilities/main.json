{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimal core permissions for the BetterComms main window. Custom capability reporting is exposed through a typed command; no shell or filesystem plugin is enabled.",
  "windows": ["main"],
  "remote": { "urls": ["https://bettrcomms-production.up.railway.app"] },
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
